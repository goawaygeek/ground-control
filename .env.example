# Player token for persistent identity across sessions.
# After your first game, save the token you receive here.
# PLAYER_TOKEN=your-uuid-here

# Notion API credentials for player persistence.
# Only required if you're running your own server.
# Get NOTION_TOKEN from Notion workspace settings → Integrations → Internal Integration
# Database schema: name (title), token (rich_text), createdAt (date with time)
# NOTION_TOKEN=secret_...
# NOTION_DATABASE_ID=34a0e4c8963980d08bcbfbde2b535b2d
